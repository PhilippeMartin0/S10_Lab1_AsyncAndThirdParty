@model int
<div class="col">
    @if (Model == 0)
    {
        <input type="submit" class="btn btn-success w-100" value="Create" /><i class="fa-solid fa-plus"></i>
    }
    else
    {
        <input type="submit" class="btn btn-info w-100" value="Edit" /><i class="fa-solid fa-pen-to-square"></i>
    }
</div>
<div class="col">
    <a asp-action="Index" class="btn btn-secondary w-100"><i class="fa-solid fa-circle-arrow-left"></i>&nbsp;Back to list</a>
</div>
